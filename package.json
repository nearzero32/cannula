{
  "name": "cannula",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bunx --bun typescript@5.9.3 --noEmit",
    "build": "bun build src/index.ts --target=bun --outdir=dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@elysia/openapi": "1.4.16",
    "@elysiajs/cors": "^1.4.1",
    "elysia": "^1.4.28",
    "elysia-rate-limit": "^4.6.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "8.24.1",
    "redis": "^5.12.1"
  },
  "overrides": {
    "nanoid": "5.1.16"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "bun-types": "latest"
  },
  "module": "src/index.js"
}
