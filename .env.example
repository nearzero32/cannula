# Copy to .env and fill in values:
#   cp .env.example .env

# ── Auth (required) ──────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-use-long-random-string
REFRESH_TOKEN_SECRET=change-me-use-different-long-random-string
OTP_HASH_SECRET=change-me-use-a-separate-long-random-string
# Development/test only. Startup fails if this is true with NODE_ENV=production.
OTP_DEBUG_RETURN_CODE=false
# HTTPS endpoint receiving { phone, otp }; required in production for patient OTP delivery.
OTP_DELIVERY_WEBHOOK_URL=

# ── MongoDB (required) ───────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/cannula?replicaSet=rs0
# Docker Compose (API runs inside the Compose network):
# MONGODB_URI=mongodb://mongo:27017/cannula?replicaSet=rs0
# MongoDB Atlas SRV deployments are also supported:
# MONGODB_URI=mongodb+srv://user:password@cluster.example/cannula
# Or embed credentials in the URI:
# MONGODB_URI=mongodb://user:password@host1,host2,host3/cannula?replicaSet=production-rs
# Transactional integration tests use a dedicated test database only:
# MONGODB_TEST_URI=mongodb://localhost:27018/cannula_pharmacy_test?replicaSet=rs0&directConnection=true
# Optional separate credentials (appended to MONGODB_URI when set):
# MONGODB_USER=
# MONGODB_PASSWORD=
# Compose-only administrative credentials; the API never receives these.
# MONGODB_ROOT_USER=
# MONGODB_ROOT_PASSWORD=
# MONGODB_KEYFILE_PATH=./secrets/mongo-keyfile
# MONGODB_REPLICA_SET_NAME=rs0
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_MAX_IDLE_TIME_MS=30000
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGODB_SOCKET_TIMEOUT_MS=45000
# Production must authenticate. Set true only for a same-host private Docker network;
# otherwise use Mongo TLS and set MONGODB_TLS=true in the deployment environment.
MONGODB_INTERNAL_NETWORK=false
# MONGODB_TLS=false

# ── Redis (required) ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_DATABASE=0
# REDIS_TLS=false
# Set true only when Redis is reachable exclusively over the private same-host Docker network.
REDIS_INTERNAL_NETWORK=false

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated origins; omit to allow all (dev only)
# ALLOWED_ORIGINS=http://localhost:5173,https://your-app.com
# Comma-separated CIDRs of reverse proxies directly trusted by Bun. Empty means forwarded IP headers are ignored.
# Recommended when the proxy runs on the same host: TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
# Swagger defaults on outside production and off in production.
ENABLE_SWAGGER=false
# Required, at least 32 random characters, only if production Swagger is explicitly enabled.
# SWAGGER_ADMIN_TOKEN=
# OTP resend cooldown is fixed to 45 seconds in the backend security policy.

# ── Super admin (first boot seed) ────────────────────────────────
# Explicit credentials are used only when no Super Admin exists.
# Production startup fails when initial bootstrap is needed and these are absent.
# SUPER_ADMIN_PHONE=
# Bootstrap password must be at least 12 characters.
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_FULL_NAME=Super Admin
# SUPER_ADMIN_EMAIL=admin@example.com

# ── Cloudflare R2 — image uploads (optional) ─────────────────────
# Create a bucket-scoped token with Object Read + Write only. These values are secrets except public URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Separate non-public bucket for pending objects and private prescription images.
R2_PRIVATE_BUCKET_NAME=
# Public URL: custom domain or R2 public bucket URL
R2_PUBLIC_URL=https://cdn.example.com
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Upload PUT lifetime, bounded by the backend to 300..900 seconds (default 600).
# R2_PRESIGN_EXPIRES_IN=600
# Global hard cap, bounded to 262144..10485760 bytes; each purpose may be smaller.
# R2_MAX_UPLOAD_BYTES=8388608

# Legacy S3-style names (fallback if R2_* not set)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_S3_ENDPOINT=

# ── Push notifications — OneSignal (optional) ───────────────────
# ONESIGNAL_APP_ID=
# ONESIGNAL_API_KEY=

# ── Firebase (optional) ──────────────────────────────────────────
FIREBASE_SERVER_KEY=

# ── Email / SMTP (optional) ──────────────────────────────────────
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# ── Other integrations (optional) ────────────────────────────────
# REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
# QI_UAT_PAYMENT_BASE_URL=
# QI_PAYMENT_BASE_URL=

# ── Runtime ──────────────────────────────────────────────────────
# NODE_ENV=development
# Production HTTPS is terminated by Cloudflare/reverse proxy; required to enable HSTS safely.
PUBLIC_HTTPS=false
# PORT=3001
# HOST=0.0.0.0
# 64 KiB..10 MiB; default is 2 MiB. Direct-to-R2 uploads do not pass through the API.
# REQUEST_BODY_LIMIT_BYTES=2097152
# Generate independent secrets with: openssl rand -hex 32
